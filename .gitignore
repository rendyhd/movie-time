# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.
/.esphome/
**/.pioenvs/
**/.piolibdeps/
**/lib/
**/src/
**/platformio.ini
/secrets.yaml
/.test-build/
/.pytest_cache/
**/__pycache__/
/.venv*/
# Hardware scratch output and intermediate CAD stages (see hardware/README.md)
/hardware/build/
/hardware/output/step/
/hardware/output/stl/
/hardware/output/plates/
/hardware/output/spring_guide/
